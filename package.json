{
  "name": "swert-treat",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "Krunchy",
    "Kremmy"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w Kremmy\" \"npm run dev -w Krunchy\"",
    "build": "npm run build -w Krunchy",
    "test": "npm run test -w Kremmy",
    "db:generate": "npm run db:generate -w Kremmy",
    "db:migrate": "npm run db:migrate -w Kremmy",
    "db:deploy": "npm run db:deploy -w Kremmy",
    "db:seed": "npm run db:seed -w Kremmy"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
